{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ESNext",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",  
    "paths": {
      "@/*": ["src/*"]              
    }
  },
  "include": ["src", "tests"]
}

